{
  "name": "madebytmy-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.5.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/prepare.ts && nuxt dev --host 127.0.0.1 --port 3002",
    "postinstall": "tsx scripts/prepare.ts && nuxt prepare",
    "generate": "tsx scripts/check-links.ts && tsx scripts/prepare.ts && nuxt generate && tsx scripts/finalize.ts && tsx scripts/check-generated-html.ts",
    "typecheck": "tsx scripts/prepare.ts && nuxt typecheck",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "check:seo": "tsx scripts/check-generated-html.ts",
    "check:links": "tsx scripts/check-links.ts",
    "preview": "tsx scripts/preview.ts",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "nuxt": "4.6.1",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@nuxt/eslint": "1.17.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "cheerio": "1.2.0",
    "eslint": "10.13.0",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "rolldown": "1.2.14",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
